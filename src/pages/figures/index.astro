---
import Base from "../../layouts/Base.astro";
import { figureUrl, getFigures } from "../../lib/content";

const figures = await getFigures();
const groups = ["Figures of history", "Rulers and leaders", "Captains of the Scar"] as const;
---

<Base title="Notable Figures" section="figures" description="The famous people of Korlornium and Erodas.">
  <div class="page">
    <header class="head">
      <h1>Notable figures</h1>
      <p class="dek">The founders, rulers, champions and captains whose names are known across Korlornium.</p>
    </header>

    {
      groups.map((group) => {
        const members = figures.filter((f) => f.data.group === group);
        if (members.length === 0) return null;
        return (
          <section>
            <h2>{group}</h2>
            <dl class="roll">
              {members.map((f) => (
                <div>
                  <dt>
                    <a href={figureUrl(f.id)}>{f.data.title}</a>
                  </dt>
                  <dd>{f.data.role}</dd>
                </div>
              ))}
            </dl>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .page {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 0;
  }
  .dek {
    max-width: var(--measure);
    color: var(--ink-soft);
    margin: 0.6rem 0 0;
  }
  .roll {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    column-gap: 3rem;
    border-top: 1px solid var(--rule);
  }
  .roll > div {
    padding: 0.8rem 0 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .roll dt a {
    font-family: var(--font-sc);
    font-size: 1.35rem;
    text-decoration: none;
  }
  .roll dt a:hover {
    text-decoration: underline;
  }
  .roll dd {
    margin: 0.1rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.45;
  }
</style>
