---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { base, getFigures } from "../../lib/content";

export async function getStaticPaths() {
  const figures = await getFigures();
  return figures.map((figure) => ({ params: { slug: figure.id }, props: { figure } }));
}

const { figure } = Astro.props as { figure: CollectionEntry<"figures"> };
const { Content } = await render(figure);
const d = figure.data;
---

<Base title={d.title} section="figures" description={`${d.title}: ${d.role}.`}>
  <article class="entry">
    <header>
      <p class="trail"><a href={`${base}/figures/`}>Notable figures</a> / {d.group}</p>
      <h1>{d.title}</h1>
      <p class="dek">{d.role}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .entry {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 0;
  }
  .trail {
    margin: 0 0 0.6rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .trail a {
    color: inherit;
  }
  .dek {
    max-width: var(--measure);
    margin: 0.7rem 0 2.5rem;
    font-size: 1.3rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.45;
  }
</style>
