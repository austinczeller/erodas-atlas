---
import Base from "../layouts/Base.astro";
import AtlasMap from "../components/AtlasMap.astro";
import { base, getPlaces, mapPins } from "../lib/content";

const pins = mapPins(await getPlaces());

const sections = [
  {
    href: `${base}/places/`,
    title: "Places",
    text: "The continents of Erodas, and the regions, cities and wild places of Korlornium.",
  },
  {
    href: `${base}/figures/`,
    title: "Notable Figures",
    text: "The founders, rulers, champions and captains whose names are known across Korlornium.",
  },
  {
    href: `${base}/species/`,
    title: "Notable Species",
    text: "The peoples of Korlornium, common and uncommon.",
  },
  {
    href: `${base}/gods/`,
    title: "Gods",
    text: "The Pantheon of Major Powers who shape the Mundane World.",
  },
  {
    href: `${base}/history/`,
    title: "History",
    text: "From the Great Wave to the Divergent War, as it is recorded in Caldrith. Also the holidays and observances of the year.",
  },
  {
    href: `${base}/sky/`,
    title: "Calendar and Sky",
    text: "The Erodian Standard Calendar, today's date, and the moons and stars of Erodas.",
  },
  {
    href: `${base}/next-adventure/`,
    title: "Next Adventure",
    text: "Everything you need to make a character for the coming campaign in Dithoria City.",
  },
];
---

<Base description="A player's atlas of Korlornium and the wider world of Erodas.">
  <section class="hero">
    <div class="hero-inner">
      <AtlasMap pins={pins} caption="Korlornium, a continent of Erodas." />
    </div>
  </section>

  <div class="intro">
    <div class="preface">
      <h1>The world of Erodas</h1>
      <p class="lead">
        Erodas is an earth-like world of many continents, beneath two moons. This atlas is mostly
        concerned with one of them: Korlornium, a small and isolated continent divided by the Scar.
        <a href={`${base}/places/erodas/`}>Read about the world of Erodas</a>.
      </p>
      <h2>Welcome to Korlornium</h2>
      <p>
        My associates and I have been compiling histories of this ancient land for as long as the
        Fowlmen have walked Siroth. Korlornium is quite a fascinating continent full of
        geopolitical conflict, natural wonders, and (more so in present day) debauchery. Due to
        the instability over the past 2000 years information is difficult to come by for this
        region. Thereby you may notice gaps in our manuscripts, but be advised we will update this
        text as new information and historical accounts come to light. We hope you enjoy reading
        the collected text and may immerse yourself in the rich and mysterious land which many of
        the authors of this text call home.
      </p>
      <div class="signature">
        <img src={`${base}/brand/society-emblem.svg`} alt="The emblem of the Erodian Atlasing Society: two moons rising from an open atlas" width="96" height="96" />
        <p>Regards,<br />The Erodian Atlasing Society</p>
      </div>
    </div>

    <ul class="contents" aria-label="Sections of the atlas">
      {
        sections.map((s) => (
          <li>
            <a href={s.href}>{s.title}</a>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .hero {
    background: var(--mast-bg);
    padding: 0 var(--gutter) clamp(1.5rem, 4vw, 3rem);
  }
  .hero :global(figcaption) {
    color: var(--mast-muted);
  }
  .hero-inner {
    max-width: 78rem;
    margin: 0 auto;
  }
  .intro {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--gutter) 0;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .preface h1 {
    margin-bottom: 0.4em;
  }
  .lead {
    font-size: 1.3rem;
    line-height: 1.5;
  }
  .preface h2 {
    margin-top: 1.6em;
  }
  .preface p {
    max-width: var(--measure);
  }
  .signature {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-style: italic;
    color: var(--ink-soft);
  }
  .signature img {
    width: 6rem;
    height: 6rem;
    flex: none;
  }
  .signature p {
    margin: 0;
  }
  .contents {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .contents li {
    padding: 1.1rem 0 1.2rem;
    border-bottom: 1px solid var(--rule);
  }
  .contents a {
    font-family: var(--font-sc);
    font-size: 1.55rem;
    text-decoration: none;
  }
  .contents a:hover {
    text-decoration: underline;
  }
  .contents p {
    margin: 0.2rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.5;
  }
  @media (max-width: 52rem) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>
