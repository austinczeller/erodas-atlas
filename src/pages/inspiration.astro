---
// The inspiration board: every image in src/assets/inspiration/ appears here,
// optimized by Astro. The file name is the caption; a leading number sets the order.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { base } from "../lib/content";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/inspiration/*.{jpg,jpeg,png,webp,avif,gif}", {
  eager: true,
});

const images = Object.entries(files)
  .map(([path, mod]) => {
    const name = path.split("/").pop()!.replace(/\.[^.]+$/, "");
    const caption = name
      .replace(/^\d+[-_ ]*/, "")
      .replace(/[-_]+/g, " ")
      .replace(/^./, (c) => c.toUpperCase());
    return { name, caption, src: mod.default };
  })
  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
---

<Base title="Inspiration board" section="next-adventure" description="Images that set the mood for the campaign in Dithoria City.">
  <div class="page">
    <header class="head">
      <p class="trail"><a href={`${base}/next-adventure/`}>Next adventure</a></p>
      <h1>Inspiration board</h1>
      <p class="dek">The people, places and mood of the campaign in Dithoria City.</p>
    </header>

    {
      images.length > 0 ? (
        <div class="board">
          {images.map((img) => (
            <figure>
              <a href={img.src.src}>
                <Image src={img.src} alt={img.caption} widths={[400, 800]} sizes="(max-width: 40rem) 100vw, 400px" />
              </a>
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="empty">No images have been pinned to the board yet.</p>
      )
    }
  </div>
</Base>

<style>
  .page {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 0;
  }
  .trail {
    margin: 0 0 0.6rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .trail a {
    color: inherit;
  }
  .dek {
    max-width: var(--measure);
    color: var(--ink-soft);
    margin: 0.6rem 0 2rem;
  }
  .board {
    columns: 3 18rem;
    column-gap: 1.25rem;
  }
  figure {
    break-inside: avoid;
    margin: 0 0 1.25rem;
  }
  figure img {
    width: 100%;
    height: auto;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
  }
  figcaption {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  .empty {
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
