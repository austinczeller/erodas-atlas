---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import ThemePicker from "../components/ThemePicker.astro";

interface Props {
  title?: string;
  description?: string;
  // Which header menu to mark as current.
  section?: string;
}

const { title, description, section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageTitle = title ? `${title} · The Erodian Atlas` : "The Erodian Atlas";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Apply the chosen colour scheme before the page paints.
      try {
        const fromUrl = new URLSearchParams(location.search).get("theme");
        if (fromUrl) localStorage.setItem("atlas-theme", fromUrl);
        const theme = localStorage.getItem("atlas-theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya+SC:wght@500;700&family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader section={section} />
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <p>
        Compiled by the Erodian Atlasing Society. Our texts are updated whenever new historical
        accounts come to light.
      </p>
      <ThemePicker />
    </footer>
  </body>
</html>

<style>
  main {
    min-height: 70vh;
  }
  .colophon {
    max-width: 78rem;
    margin: 5rem auto 0;
    padding: 1.5rem var(--gutter) 3rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .colophon p {
    margin: 0;
    max-width: var(--measure);
    font-style: italic;
  }
</style>
