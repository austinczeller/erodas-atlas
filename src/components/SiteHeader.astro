---
// The header on every page: the wordmark and the dropdown navigation.
// Menus come from src/lib/nav.ts; this component only draws them.
import { getNav } from "../lib/nav";
import { base } from "../lib/content";

interface Props {
  section?: string;
}

const { section } = Astro.props;
const menus = await getNav();
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="wordmark" href={`${base}/`}>
      <img src={`${base}/brand/society-emblem.svg`} alt="" width="40" height="40" />
      The Erodian Atlas
    </a>
    <nav aria-label="Atlas sections">
      <ul class="menubar">
        {
          menus.map((menu) => (
            <li class:list={["item", { current: section === menu.id }]}>
              {menu.groups && menu.groups.length > 0 ? (
                <details class="menu">
                  <summary aria-current={section === menu.id ? "page" : undefined}>{menu.label}</summary>
                  <div class="panel">
                    <a class="overview" href={menu.href}>
                      {menu.overview}
                    </a>
                    <div class="groups">
                      {menu.groups.map((group) => (
                        <div class="group">
                          <p class="heading">{group.heading}</p>
                          <ul>
                            {group.links.map((l) => (
                              <li>
                                <a href={l.href}>{l.label}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </details>
              ) : (
                <a class="plain" href={menu.href} aria-current={section === menu.id ? "page" : undefined}>
                  {menu.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // One menu open at a time; close on Escape or a click outside the header.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>(".masthead details.menu")];
  for (const menu of menus) {
    menu.addEventListener("toggle", () => {
      if (menu.open) menus.forEach((m) => m !== menu && (m.open = false));
    });
  }
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".masthead")) menus.forEach((m) => (m.open = false));
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = menus.find((m) => m.open);
    if (open) {
      open.open = false;
      open.querySelector("summary")?.focus();
    }
  });
</script>

<style>
  .masthead {
    background: var(--mast-bg);
    color: var(--mast-fg);
    position: relative;
    z-index: 20;
  }
  .masthead-inner {
    position: relative;
    max-width: 78rem;
    margin: 0 auto;
    padding: 0.85rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sc);
    font-weight: 700;
    font-size: 1.45rem;
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .wordmark img {
    width: 2.5rem;
    height: 2.5rem;
  }
  .masthead-inner {
    align-items: center;
  }
  .menubar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  summary,
  .plain {
    font-family: var(--font-sc);
    font-size: 1.06rem;
    color: var(--mast-muted);
    text-decoration: none;
    padding: 0.2em 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "";
    display: inline-block;
    width: 0.38em;
    height: 0.38em;
    margin-left: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.2em) rotate(45deg);
    transition: transform 120ms ease;
  }
  details[open] summary::after {
    transform: translateY(0.05em) rotate(-135deg);
  }
  summary:hover,
  .plain:hover,
  details[open] summary {
    color: var(--mast-fg);
  }
  .current summary,
  .current .plain {
    color: var(--mast-fg);
    border-bottom-color: var(--mast-accent);
  }

  /* The dropdown spans the header's width, under the bar. */
  .panel {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 100%;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--mast-accent);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.45);
    padding: 1.2rem 1.5rem 1.4rem;
  }
  .overview {
    font-family: var(--font-sc);
    font-size: 1.15rem;
  }
  .groups {
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem 2rem;
  }
  .heading {
    margin: 0 0 0.3rem;
    font-family: var(--font-sc);
    color: var(--ink-soft);
    font-size: 0.98rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.2rem;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 1rem;
    line-height: 1.75;
  }
  .group a {
    color: var(--ink);
    text-decoration: none;
  }
  .group a:hover {
    color: var(--label-red);
    text-decoration: underline;
  }
  @media (max-width: 40rem) {
    .panel {
      left: 0.5rem;
      right: 0.5rem;
      max-height: 70vh;
      overflow-y: auto;
    }
  }
</style>
